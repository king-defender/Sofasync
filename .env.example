DATABASE_URL="postgresql://sofasync:sofasync@localhost:5432/sofasync?schema=public"
REDIS_URL="redis://localhost:6380"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="replace-with-a-long-random-string"
PORT=3000

# --- OAuth (leave a provider's pair blank to disable it - login/signup will
# show "not configured" instead of faking a login) ---
# Google: console.cloud.google.com -> APIs & Services -> Credentials
#   Authorized redirect URI: http://localhost:3000/api/auth/oauth/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GitHub: github.com/settings/developers -> OAuth Apps
#   Authorization callback URL: http://localhost:3000/api/auth/oauth/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Discord: discord.com/developers/applications -> OAuth2
#   Redirect: http://localhost:3000/api/auth/oauth/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# --- Outbound email (verification + password reset) ---
# Leave blank to fall back to console-logging the link (dev only, clearly
# labeled "[DEV MODE - no SMTP configured]" in the server logs). Any free-tier
# SMTP works - e.g. Resend, Mailtrap, or a Gmail app password.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Sofa Sync <no-reply@sofasync.local>"
